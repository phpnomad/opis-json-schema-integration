{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phpnomad.example/schemas/person.json",
  "title": "Person",
  "type": "object",
  "required": ["name", "age"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  }
}
