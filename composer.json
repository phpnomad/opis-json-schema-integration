{
    "name": "phpnomad/opis-json-schema-integration",
    "description": "Concrete PHPNomad JsonSchemaValidatorStrategy backed by opis/json-schema. Drop-in implementation with draft 2020-12 support.",
    "type": "library",
    "homepage": "https://github.com/phpnomad/opis-json-schema-integration",
    "readme": "README.md",
    "license": "MIT",
    "keywords": [
        "phpnomad",
        "json-schema",
        "validation",
        "opis",
        "integration"
    ],
    "scripts": {
        "php-cs-fixer": "php-cs-fixer fix",
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "PHPNomad\\OpisJsonSchema\\Integration\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPNomad\\OpisJsonSchema\\Integration\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alex Standiford",
            "email": "alex@standiford.us"
        }
    ],
    "require": {
        "php": ">=8.2",
        "phpnomad/json-schema": "^1.0",
        "opis/json-schema": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
